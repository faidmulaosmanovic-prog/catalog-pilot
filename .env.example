# Copy to .env.local for local development.
# Never commit real secrets.

# PostgreSQL connection string (required)
# Local example (see docs/development/DATABASE_PHASES.md DB-0):
DATABASE_URL=postgresql://catalogpilot:catalogpilot@localhost:5432/catalogpilot

# Neon example:
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Stripe Billing. Leave empty until Checkout is configured.
# Put the price ids on the plans rows (stripe_price_id_monthly), not in this file.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional. Unexpected server errors are reported here. Leave empty to log locally only.
SENTRY_DSN=
